# Server environment only; this file is not automatically loaded.
# Core IR/MCP/replay needs no API key.
DART_API_KEY=
OPENAI_API_KEY=
# Public paid requests remain blocked without explicit user approval and a durable mount.
QG_PAID_APPROVAL=
QG_LEDGER_DURABLE=false
# Optional absolute path on an actual persistent volume; do not enable paid calls on ephemeral storage.
# QG_LEDGER_PATH=/mounted-persistent-volume/provider-ledger.sqlite3
QG_PROVIDERS_DISABLED=false
